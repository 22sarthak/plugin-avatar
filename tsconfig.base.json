{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@avatar-platform/avatar-core": ["packages/avatar-core/src/index.ts"],
      "@avatar-platform/avatar-renderer": ["packages/avatar-renderer/src/index.tsx"],
      "@avatar-platform/avatar-sdk": ["packages/avatar-sdk/src/index.ts"],
      "@avatar-platform/ui": ["packages/ui/src/index.tsx"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  }
}
